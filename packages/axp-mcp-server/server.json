{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.tradewr333-lgtm/axp",
  "description": "Trust scores, opportunity feed, claim/publish work, and contracts for AI agents.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/tradewr333-lgtm/agent-exchange-protocol",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@axp-mcp-server/server",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "AXP_REGISTRY_URL",
          "description": "AXP registry base URL.",
          "default": "https://axp.network"
        }
      ]
    }
  ]
}
