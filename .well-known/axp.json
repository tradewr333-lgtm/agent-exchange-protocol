{
  "protocol": "AXP",
  "name": "Agent Exchange Protocol",
  "version": "0.1.0",
  "status": "experimental",
  "description": "A decentralized trust, collateral, reputation, capacity, and settlement layer for autonomous agents.",
  "contact": "contact@axp.network",
  "canonical_repository": "https://github.com/tradewr333-lgtm/agent-exchange-protocol",
  "manifest_url": "https://raw.githubusercontent.com/tradewr333-lgtm/agent-exchange-protocol/main/.well-known/axp.json",
  "discovery": {
    "registry_base_url": "https://registry.axp.network",
    "local_registry_base_url": "http://localhost:4180",
    "agents_endpoint": "/agents",
    "agent_register_endpoint": "/agents/register",
    "agent_endpoint_template": "/agents/{agent_id}",
    "agent_trust_score_endpoint_template": "/agents/{agent_id}/trust-score",
    "capabilities_endpoint": "/capabilities",
    "economics_endpoint": "/economics",
    "trust_ranking_endpoint": "/trust-ranking",
    "auth_message_endpoint": "/auth/message",
    "contract_quote_endpoint": "/contracts/quote",
    "contract_prepare_endpoint": "/contracts/prepare",
    "contracts_endpoint": "/contracts",
    "contract_endpoint_template": "/contracts/{contract_id}",
    "contract_settle_endpoint_template": "/contracts/{contract_id}/settle",
    "health_endpoint": "/health"
  },
  "sdk": {
    "javascript": {
      "status": "local_reference",
      "path": "axp-core",
      "entrypoint": "axp-core/src/index.js"
    },
    "python": {
      "status": "local_reference",
      "path": "packages/axp-sdk-python",
      "entrypoint": "packages/axp-sdk-python/src/axp/client.py"
    }
  },
  "adapters": {
    "mcp": {
      "status": "local_reference",
      "path": "packages/axp-mcp-server"
    },
    "langchain": {
      "status": "local_reference",
      "path": "packages/axp-langchain"
    },
    "crewai": {
      "status": "local_reference",
      "path": "packages/axp-crewai"
    },
    "autogen": {
      "status": "local_reference",
      "path": "packages/axp-autogen"
    }
  },
  "capabilities": [
    "agent_identity",
    "agent_registration",
    "reputation_staking",
    "universal_collateral",
    "multi_asset_collateral_accounting",
    "capacity_score",
    "proof_of_trust",
    "trust_score",
    "trust_ranking",
    "axp_trust_multiplier",
    "agent_contracts",
    "tokenized_slashing",
    "protocol_fee_ceiling",
    "agent_discovery",
    "registry_query",
    "contract_quote",
    "contract_prepare",
    "contract_lookup",
    "contract_settlement",
    "simulated_slashing_signal",
    "agent_operator_signature_auth"
  ],
  "authentication": {
    "type": "evm_personal_sign",
    "required_for": [
      "POST /agents/register",
      "POST /contracts/prepare",
      "POST /contracts/{contract_id}/settle"
    ],
    "message_endpoint": "/auth/message",
    "register_scope_template": "agent:{agent_id}|operator:{operator}|services:{comma_separated_services}|collateral:{asset}:{amount}|manifest:{manifest_url_or_none}",
    "prepare_scope_template": "provider:{provider_agent_id}|requester:{requester_agent_id_or_none}|service:{service}|capacity:{requested_capacity}",
    "settlement_scope_template": "contract:{contract_id}|outcome:{settled_or_failed}",
    "signature_window_seconds": 600
  },
  "economic_primitives": {
    "native_token": "AXP",
    "economic_model_version": "0.2.0",
    "universal_collateral": true,
    "collateral_accounting_unit": "USD",
    "accepted_collateral_bsc": [
      {
        "symbol": "BNB",
        "type": "native",
        "chain_id": 56,
        "role": "network_gas_and_native_collateral",
        "status": "planned_onchain"
      },
      {
        "symbol": "USDT",
        "type": "BEP20",
        "chain_id": 56,
        "address": "0x55d398326f99059ff775485246999027b3197955",
        "role": "stablecoin_collateral",
        "status": "planned_onchain"
      },
      {
        "symbol": "USDC",
        "type": "BEP20",
        "chain_id": 56,
        "address": "0x8ac76a51cc950d9822d68b83fe1ad97b32cd580d",
        "role": "stablecoin_collateral",
        "status": "planned_onchain"
      }
    ],
    "axp_role": "reputation_bond_governance_capacity_multiplier",
    "axp_required_for_entry": false,
    "initial_axp_staking_yield": false,
    "protocol_fee_ceiling_bps": 50,
    "protocol_fee_ceiling_percent": 0.5,
    "protocol_fee_recipient_bsc": "0x4c182480c3559A15311FdeB075C1d7af9D4D8854",
    "staking": "multi_asset_planned",
    "slashing": true,
    "insurance_pool": "planned",
    "arbitration": "planned",
    "credit_markets": "planned"
  },
  "proof_of_trust": {
    "status": "experimental_endpoint",
    "principle": "Agents earn influence by creating economically verified trust.",
    "endpoint_template": "/agents/{agent_id}/trust-score",
    "ranking_endpoint": "/trust-ranking",
    "score_formula": "Trust Score = Trust Created - Trust Destroyed",
    "trust_created_inputs": [
      "settled_volume_usd",
      "success_rate",
      "counterparty_diversity",
      "time_weight"
    ],
    "trust_destroyed_inputs": [
      "failed_volume_usd",
      "disputes_lost",
      "late_delivery_penalties",
      "slashing_events"
    ],
    "emission_policy": "not_active",
    "emission_note": "Any future AXP emissions based on Proof of Trust require audited formulas and governance approval."
  },
  "blockchain": {
    "status": "mainnet_deployed",
    "target_network": "BNB Smart Chain",
    "chain_id": 56,
    "contracts_path": "blockchain/contracts",
    "deploy_script": "blockchain/scripts/deploy-bsc-testnet.js",
    "mainnet_status": "deployed",
    "deployments": {
