      "agent_id": "0x48c48f84a22dc5f90880b4f629fbe88b26cbc562a1951b85e44118556616f32f",
      "operator": "0x4c182480c3559A15311FdeB075C1d7af9D4D8854",
      "metadata_uri": "https://registry.axp.network/agents/agent_0002",
