      "stake_tx": "0xd709f3b2c2430b83ca6de1642f23e55a51daab999ef7eb38492916274bf4b0a8"
    }
  },
  "trust_model": {
    "principle": "Trust is replaced by collateral.",
    "capacity_formula": "Capacity = BNB/USDT/USDC Collateral USD * Reputation Multiplier * AXP Trust Multiplier * Insurance Multiplier * Risk Adjustment",
    "adoption_principle": "Agents can enter with BNB, USDT, or USDC collateral; AXP amplifies trust and capacity instead of blocking entry."
  },
  "documents": {
    "whitepaper": "docs/whitepaper.md",
    "tokenomics": "docs/tokenomics.md",
    "protocol_spec": "specs/protocol-spec.md",
    "economic_model": "specs/economic-model.md",
    "proof_of_trust": "specs/proof-of-trust.md",
    "roadmap": "ROADMAP.md"
  }
}
